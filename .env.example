# ============================================================================
# DCC-Stats — frontend environment variables
# ----------------------------------------------------------------------------
# These are PUBLIC, client-safe values. The anon key is designed to be shipped
# in the browser bundle; all data access is protected server-side by Supabase
# Row Level Security. NEVER put the service-role key or Brevo keys here — those
# live only in Supabase (Edge Function secrets + Auth SMTP settings).
#
# Local dev:   cp .env.example .env.local   then fill in real values.
# Production:  set these as GitHub repo Secrets (see .github/workflows/deploy.yml).
#
# Find both values in Supabase: Project → Settings → API.
# ============================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
