# Local environment files (keep .env.example tracked)
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.temp
supabase/.branches

# Claude Code local state. `.claude/worktrees/` holds checked-out worktrees in
# the main clone, so ignore the directory and opt the shared dev-server config
# back in rather than tracking it wholesale.
.claude/*
!.claude/launch.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
